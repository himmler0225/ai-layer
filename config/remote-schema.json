{
  "version": 1,
  "keys": {
    "AI_AGENT": {
      "bind": {
        "type": "flat_prefix",
        "prefix": "AGENT_",
        "module": "settings",
        "cast": "int"
      },
      "fields": [
        "max_iter",
        "max_comments",
        "max_comment_len",
        "max_list_items",
        "max_result_chars",
        "curated_top_n"
      ],
      "bool_fields": ["include_review_summary"],
      "store": "agent"
    },
    "AI_MODELS": {
      "bind": {
        "type": "provider",
        "module": "settings",
        "providers": {
          "openai": "OPENAI",
          "deepseek": "DEEP_SEEK",
          "xah": "XAH",
          "kira": "KIRA"
        },
        "id_field": "id",
        "string_fields": ["api_key", "base_url", "model", "tool_model"],
        "int_fields": ["max_tokens", "tool_max_tokens"],
        "skip_fields": ["is_active"]
      },
      "store": "models"
    },
    "PROMPTS": {
      "bind": { "type": "group_field", "module": "prompts" },
      "groups": {
        "agent": ["system", "synth_system"],
        "review_summary": ["system", "prompt"],
        "aspect_group": ["system", "prompt"],
        "aspect_summary": ["system", "prompt"]
      },
      "store": "prompts",
      "mirror": [
        {
          "group": "agent",
          "field": "system",
          "module": "settings",
          "attr": "AGENT_SYSTEM"
        }
      ]
    },
    "SERVICES": {
      "bind": {
        "type": "service",
        "module": "settings",
        "services": {
          "ai_layer": { "url": "str", "key": "str" },
          "data_miner": {
            "url": "str",
            "key": "str",
            "timeout": "int",
            "service_token": "str"
          }
        }
      },
      "store": "services"
    },
    "RATE_LIMIT": {
      "bind": {
        "type": "rate_limit_apis",
        "module": "settings",
        "apis": ["agent", "youtube", "qr", "shorten"]
      },
      "store": "rate_limit"
    }
  },
  "required": [
    "AGENT_MAX_ITER",
    "AGENT_SYSTEM",
    "REVIEW_SUMMARY_SYSTEM",
    "REVIEW_SUMMARY_PROMPT",
    "ASPECT_GROUP_SYSTEM",
    "ASPECT_GROUP_PROMPT",
    "ASPECT_SUMMARY_SYSTEM",
    "ASPECT_SUMMARY_PROMPT",
    "DATA_MINER_URL",
    "DATA_MINER_KEY"
  ],
  "admin": {
    "groups": {
      "models": ["AI_MODELS"],
      "agent": ["AI_AGENT"],
      "limits": ["RATE_LIMIT"],
      "prompts": ["PROMPTS"],
      "services": ["SERVICES"],
      "miner": ["PROXY_POOLS"]
    },
    "standalone_keys": [],
    "json_keys": ["AI_AGENT", "AI_MODELS", "PROMPTS", "RATE_LIMIT", "SERVICES"],
    "secret_keys": ["AI_MODELS", "SERVICES"],
    "long_text_keys": ["PROMPTS"]
  }
}
