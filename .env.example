# This service auth
API_KEYS=your-ai-layer-key-1,your-ai-layer-key-2
CORS_ORIGINS=http://localhost:3000

# Local fallback khi chưa có Supabase (prod: SERVICES.data_miner trên bảng config)
# DATA_MINER_URL=http://localhost:8000
# DATA_MINER_TIMEOUT=60

# Supabase — Auth + profiles + config (REST) + Postgres (app data / RAG)
# Dashboard → Settings → Database → Connection string (pooler 6543 khuyến nghị)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# OPENAI_*, AGENT_*, DATA_MINER_KEY, AGENT_SYSTEM prompt → bảng `config`

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# LLM — provider active chọn trong Supabase AI_MODELS (is_active: true).
# LLM_EMBEDDING_PROVIDER=openai

# GeoIP (optional)
GEOIP_DB_PATH=

# Logging
LOG_LEVEL=INFO

# RabbitMQ — knowledge ingest (API publish, ingest-worker consume)
# Local dev (docker compose rabbitmq on localhost):
RABBITMQ_URL=amqp://ingest:changeme@localhost:5672/
# Docker stack (ai-layer / ingest-worker containers — compose overrides this):
# RABBITMQ_URL=amqp://ingest:changeme@rabbitmq:5672/
RABBITMQ_EXCHANGE=knowledge.ingest
INGEST_ENABLED=true
# Local: true (một lệnh fastapi run). Docker Compose: false trên ai-layer (worker riêng)
INGEST_WORKER_INLINE=true
# Management UI: http://localhost:15672 (user: ingest)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# MCP — crawl tools via data-miner (set AGENT_CRAWL_BACKEND=mcp)
AGENT_CRAWL_BACKEND=http
MCP_TRANSPORT=sse
# MCP_SSE_URL derived from DATA_MINER_URL if unset → {DATA_MINER_URL}/mcp/sse
# MCP_SERVICE_TOKEN=           # optional; matches data-miner MCP_AUTH_TOKEN
RAG_ENABLED=true
RAG_TOP_K=8
RAG_MIN_SCORE=0.65
CACHE_TTL_DAYS=7
# Top curated reviews (prod: AI_AGENT.curated_top_n)
# AGENT_CURATED_TOP_N=300

# DB schema (chạy một lần): config/supabase-setup.sql rồi alembic upgrade head
