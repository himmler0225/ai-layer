# This service auth
API_KEYS=your-ai-layer-key-1,your-ai-layer-key-2
CORS_ORIGINS=http://localhost:3000

# Downstream data-miner (URL via env; DATA_MINER_KEY comes from Supabase config)
DATA_MINER_URL=http://localhost:8000
DATA_MINER_TIMEOUT=60

# youtube-api (optional downstream)
YOUTUBE_API_URL=http://localhost:3000
YOUTUBE_API_KEY=your-youtube-api-jwt

# PostgreSQL LOCAL — toàn bộ dữ liệu (videos, RAG, chat history). Không trỏ Supabase Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reviewmine

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Supabase — CHỈ Auth + bảng `profiles` + bảng `config`. Không lưu review/RAG/chat.
# OPENAI_*, AGENT_*, DATA_MINER_KEY, AGENT_SYSTEM prompt → bảng `config`
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# DeepSeek — agent tool + RAG ingest (router chọn provider theo task)
DEEP_SEEK_API_KEY=
DEEP_SEEK_MODEL=deepseek-chat
DEEP_SEEK_TOOL_MODEL=deepseek-chat

# GeoIP (optional)
GEOIP_DB_PATH=

# Logging
LOG_LEVEL=INFO

# RabbitMQ — knowledge ingest (API publish, ingest-worker consume)
# Local dev (docker compose rabbitmq on localhost):
RABBITMQ_URL=amqp://ingest:changeme@localhost:5672/
# Docker stack (ai-layer / ingest-worker containers — compose overrides this):
# RABBITMQ_URL=amqp://ingest:changeme@rabbitmq:5672/
RABBITMQ_EXCHANGE=knowledge.ingest
INGEST_ENABLED=true
# Local: true (một lệnh fastapi run). Docker Compose: false trên ai-layer (worker riêng)
INGEST_WORKER_INLINE=true
# Management UI: http://localhost:15672 (user: ingest)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
